<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- .nuget-local/ first (sandbox vendors packages offline); nuget.org
       fallback for machines with internet (e.g. the Windows VM). -->
  <packageSources>
    <add key="local" value=".nuget-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
