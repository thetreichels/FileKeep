<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v5 installer for FileKeep.
     The apps publish as single-file executables (PublishSingleFile in the
     csproj), so the payload is a handful of explicit files — no harvesting.
     Build on Windows with the WiX v5 dotnet tool:
       wix build -arch x64 -d SrcRoot=C:\ub\src -d CliBin=C:\ub\publish\cli -d ServiceBin=C:\ub\publish\service -d RecoveryBin=C:\ub\publish\recovery -d VssBin=C:\ub\publish\vss -o filekeep-0.8.5.msi install/UsenetBackup.wxs
     IMPORTANT: re-publish with the current csproj (single-file) before building;
     the MSI installs only the files listed below.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="FileKeep"
           Version="0.8.5"
           Manufacturer="J. Treichel"
           UpgradeCode="F6E0D6D1-61A1-4843-87B9-2825A47A18DD"
           Scope="perMachine"
           InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version of FileKeep is already installed." />

    <Media Id="1" Cabinet="product.cab" EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FileKeep">
        <Directory Id="CLIDIR" Name="cli" />
        <Directory Id="SERVICEDIR" Name="service" />
        <Directory Id="GUIDIR" Name="gui" />
        <Directory Id="WIZARDDIR" Name="wizard" />
        <Directory Id="DOCSDIR" Name="docs" />
        <Directory Id="WINREDIR" Name="winre" />
      </Directory>
    </StandardDirectory>

    <!-- Service runtime data (config, logs) lives here, not in Program Files -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="APPDATADIR" Name="FileKeep" />
    </StandardDirectory>

    <!-- Start menu shortcut: launches the native FileKeep GUI app -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenu" Name="FileKeep">
        <Component Id="DashboardShortcut" Guid="*" Directory="AppStartMenu">
          <Shortcut Id="DashboardShortcut"
                    Name="FileKeep"
                    Description="Open FileKeep"
                    Target="[#GuiExeFile]"
                    WorkingDirectory="GUIDIR" />
          <RemoveFolder Id="RemoveAppStartMenu" Directory="AppStartMenu" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\FileKeep"
                         Name="DashboardShortcut"
                         Value="1"
                         Type="integer"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Desktop shortcut: optional, same target as the Start menu entry -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="FileKeep"
                  Description="Open FileKeep"
                  Target="[#GuiExeFile]"
                  WorkingDirectory="GUIDIR" />
        <RegistryValue Root="HKLM"
                       Key="Software\FileKeep"
                       Name="DesktopShortcut"
                       Value="1"
                       Type="integer"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- CLI (single-file exe; native SQLite is bundled inside) -->
    <ComponentGroup Id="CliFiles" Directory="CLIDIR">
      <Component Id="CliExe" Guid="*">
        <File Id="CliExeFile" Source="$(var.CliBin)\FileKeep.exe" KeyPath="yes" />
        <File Id="VssHelperExe" Source="$(var.VssBin)\FileKeepVss.exe" />
        <RemoveFile Id="RemoveCliPdb" Directory="CLIDIR" Name="*.pdb" On="uninstall" />
        <RemoveFolder Id="RemoveCliDir" Directory="CLIDIR" On="uninstall" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="GuiFiles" Directory="GUIDIR">
      <Component Id="GuiExe" Guid="*">
        <File Id="GuiExeFile" Source="$(var.GuiBin)\FileKeepGui.exe" KeyPath="yes" />
        <RemoveFolder Id="RemoveGuiDir" Directory="GUIDIR" On="uninstall" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ServiceRegistration" Directory="SERVICEDIR">
      <Component Id="ServiceExecutable">
        <File Id="ServiceExe" Source="$(var.ServiceBin)\FileKeepService.exe" KeyPath="yes" />
        <!-- Clean up runtime data in ProgramData on uninstall (config has
             machine-bound DPAPI blobs; logs may contain paths). -->
        <RemoveFile Id="RemoveAppDataJson" Directory="APPDATADIR" Name="service.json" On="uninstall" />
        <RemoveFile Id="RemoveAppDataLog" Directory="APPDATADIR" Name="service.log" On="uninstall" />
        <RemoveFolder Id="RemoveAppDataDir" Directory="APPDATADIR" On="uninstall" />
        <ServiceInstall Id="BackupService"
                        Type="ownProcess"
                        Name="FileKeep"
                        DisplayName="FileKeep Service"
                        Description="Scheduled encrypted backups to Usenet."
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal" />
        <ServiceControl Id="BackupServiceControl"
                        Name="FileKeep"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="true" />
        <!-- Clean up runtime-created files (service writes config/logs here, single-file exe extracts native libs) -->
        <RemoveFile Id="RemoveServiceJson" Directory="SERVICEDIR" Name="service.json" On="uninstall" />
        <RemoveFile Id="RemoveServiceLog" Directory="SERVICEDIR" Name="service.log" On="uninstall" />
        <RemoveFile Id="RemoveSqliteDll" Directory="SERVICEDIR" Name="e_sqlite3.dll" On="uninstall" />
        <RemoveFile Id="RemoveServicePdb" Directory="SERVICEDIR" Name="*.pdb" On="uninstall" />
        <RemoveFile Id="RemoveAspNetDll" Directory="SERVICEDIR" Name="aspnetcorev2_inprocess.dll" On="uninstall" />
        <RemoveFile Id="RemoveWebConfig" Directory="SERVICEDIR" Name="web.config" On="uninstall" />
        <RemoveFolder Id="RemoveServiceDir" Directory="SERVICEDIR" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- Recovery wizard (single-file exe; native SQLite is bundled inside) -->
    <ComponentGroup Id="RecoveryFiles" Directory="WIZARDDIR">
      <Component Id="RecoveryExe" Guid="*">
        <File Id="RecoveryExeFile" Source="$(var.RecoveryBin)\FileKeepRecovery.exe" KeyPath="yes" />
        <RemoveFolder Id="RemoveWizardDir" Directory="WIZARDDIR" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- Service config example + recovery runbook -->
    <ComponentGroup Id="Docs" Directory="DOCSDIR">
      <Component Id="DocsComponent" Guid="43631F00-26CB-46A7-BD8F-38DB44EC4A54">
        <File Source="$(var.SrcRoot)\src\UsenetBackup.Service\service.example.json" Name="service.example.json" />
        <File Source="$(var.SrcRoot)\docs\RECOVERY.md" Name="RECOVERY.md" />
        <File Source="$(var.SrcRoot)\LICENSE" Name="LICENSE.txt" />
        <File Source="$(var.SrcRoot)\docs\THIRD-PARTY-NOTICES.md" Name="THIRD-PARTY-NOTICES.md" />
        <RemoveFolder Id="RemoveDocsDir" Directory="DOCSDIR" On="uninstall" />
        <RemoveFolder Id="RemoveInstallDir" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
    </ComponentGroup>


    <!-- WinRE USB build script (used by the dashboard's WinRE USB GUI; ADK-free) -->
    <ComponentGroup Id="WinREFiles" Directory="WINREDIR">
      <Component Id="WinREBuildScript" Guid="*">
        <File Source="$(var.SrcRoot)\winre\build-winre-usb.ps1" Name="build-winre-usb.ps1" KeyPath="yes" />
        <RemoveFolder Id="RemoveWinREDir" Directory="WINREDIR" On="uninstall" />
      </Component>
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="FileKeep" Level="1">
      <ComponentGroupRef Id="CliFiles" />
      <ComponentGroupRef Id="GuiFiles" />
      <ComponentGroupRef Id="ServiceRegistration" />
      <ComponentGroupRef Id="RecoveryFiles" />
      <ComponentGroupRef Id="Docs" />
      <ComponentGroupRef Id="WinREFiles" />
      <ComponentRef Id="DashboardShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Standard install wizard (welcome, install dir, verify, progress).
         Without this the MSI installs with no UI at all.
         NOTE (WiX v4+): the dialog set must be referenced via the UI
         extension's ui:WixUI element; the old v3 <UIRef> no longer resolves. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- Launch FileKeep when the installer finishes (checkbox on the exit dialog)
         TEMPORARILY DISABLED: WixCA binary not resolving in this build env.
         The bundle provides launch via its Success page button. -->
    <!--
    <Property Id="WixShellExecTarget" Value="[#GuiExeFile]" />
    <CustomAction Id="LaunchFileKeep" BinaryRef="WixCA" DllEntry="WixShellExec"
                  Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="LaunchFileKeep" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1" />
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch FileKeep" />
    -->

    <!-- Add/Remove Programs icon -->
    <Icon Id="FileKeepIcon" SourceFile="$(var.SrcRoot)/assets/filekeep.ico" />
    <Property Id="ARPPRODUCTICON" Value="FileKeepIcon" />

    <!-- Installer banner (top) and dialog (side) bitmaps -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.SrcRoot)/assets/filekeep-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.SrcRoot)/assets/filekeep-dialog.bmp" />

    <!-- License text shown in the wizard (replaces the WiX placeholder) -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.SrcRoot)/install/gpl-3.0-license.rtf" />
  </Package>
</Wix>
