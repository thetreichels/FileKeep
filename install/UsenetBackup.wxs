<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v5 installer for Usenet Backup. Build on Windows: wix build -arch x64 with -d CliBin, -d ServiceBin, -d RecoveryBin pointing at self-contained publish outputs. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Usenet Backup"
           Version="0.8.0"
           Manufacturer="Usenet Backup"
           UpgradeCode="F6E0D6D1-61A1-4843-87B9-2825A47A18DD">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Usenet Backup is already installed." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="UsenetBackup" />
    </StandardDirectory>

    <!--
      WiX v5 auto-harvest: <Files> is a child of ComponentGroup (not Component).
      Each discovered file becomes its own component with a stable GUID derived
      from its install path. Subdirectories are recreated via ** recursion.
    -->
    <ComponentGroup Id="CliFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.CliBin)\**" />
    </ComponentGroup>

    <ComponentGroup Id="ServiceFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.ServiceBin)\**">
        <!-- The service exe lives in ServiceExecutable below (ServiceInstall must
             share a component with its executable). -->
        <Exclude Files="$(var.ServiceBin)\usenet-backup-service.exe" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="RecoveryFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.RecoveryBin)\**" />
    </ComponentGroup>

    <!-- Windows service executable + registration (explicit component so the
         ServiceInstall shares a component with its executable). -->
    <ComponentGroup Id="ServiceRegistration" Directory="INSTALLFOLDER">
      <Component Id="ServiceExecutable" Bitness="always64">
        <File Id="ServiceExe"
              Source="$(var.ServiceBin)\usenet-backup-service.exe"
              KeyPath="true" />
        <ServiceInstall Id="BackupService"
                        Type="ownProcess"
                        Name="UsenetBackup"
                        DisplayName="Usenet Backup Service"
                        Description="Scheduled encrypted backups to Usenet."
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal" />
        <ServiceControl Id="BackupServiceControl"
                        Name="UsenetBackup"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="true" />
      </Component>
    </ComponentGroup>

    <!-- Service config example + recovery runbook. -->
    <ComponentGroup Id="Docs" Directory="INSTALLFOLDER">
      <Component Id="DocsComponent" Guid="43631F00-26CB-46A7-BD8F-38DB44EC4A54" Bitness="always64">
        <File Source="install/service.example.json" Name="service.example.json" />
        <File Source="docs/RECOVERY.md" Name="RECOVERY.md" />
      </Component>
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="Usenet Backup" Level="1">
      <ComponentGroupRef Id="CliFiles" />
      <ComponentGroupRef Id="ServiceFiles" />
      <ComponentGroupRef Id="RecoveryFiles" />
      <ComponentGroupRef Id="ServiceRegistration" />
      <ComponentGroupRef Id="Docs" />
    </Feature>
  </Package>
</Wix>
