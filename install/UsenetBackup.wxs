<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v5 installer for Usenet Backup.
     File payload is generated by install/build-msi.ps1 into install/_harvest.wxs
     (one component per file, explicit unique IDs, stable GUIDs). Build with:
       .\install\build-msi.ps1 -SourceDir C:\ub\src -CliBin C:\ub\publish\cli `
           -ServiceBin C:\ub\publish\service -RecoveryBin C:\ub\publish\recovery `
           -OutputMsi C:\ub\usenet-backup-0.8.0-x64.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Usenet Backup"
           Version="$(var.ProductVersion)"
           Manufacturer="Usenet Backup"
           UpgradeCode="F6E0D6D1-61A1-4843-87B9-2825A47A18DD">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Usenet Backup is already installed." />

    <!-- Each app gets its own subdirectory: the three self-contained publishes
         share identical .NET runtime filenames, so a flat layout would collide. -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="UsenetBackup">
        <Directory Id="CLIDIR" Name="cli" />
        <Directory Id="SERVICEDIR" Name="service" />
        <Directory Id="WIZARDDIR" Name="wizard" />
      </Directory>
    </StandardDirectory>

    <!-- Windows service executable + registration (ServiceInstall must share
         a component with its executable). The remaining service files come
         from the generated ServiceFiles group. -->
    <ComponentGroup Id="ServiceRegistration" Directory="SERVICEDIR">
      <Component Id="ServiceExecutable" Bitness="always64">
        <File Id="ServiceExe"
              Source="$(var.ServiceBin)\usenet-backup-service.exe"
              KeyPath="true" />
        <ServiceInstall Id="BackupService"
                        Type="ownProcess"
                        Name="UsenetBackup"
                        DisplayName="Usenet Backup Service"
                        Description="Scheduled encrypted backups to Usenet."
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal" />
        <ServiceControl Id="BackupServiceControl"
                        Name="UsenetBackup"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="true" />
      </Component>
    </ComponentGroup>

    <!-- Service config example + recovery runbook. -->
    <ComponentGroup Id="Docs" Directory="INSTALLFOLDER">
      <Component Id="DocsComponent" Guid="43631F00-26CB-46A7-BD8F-38DB44EC4A54" Bitness="always64">
        <File Source="install/service.example.json" Name="service.example.json" />
        <File Source="docs/RECOVERY.md" Name="RECOVERY.md" />
      </Component>
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="Usenet Backup" Level="1">
      <ComponentGroupRef Id="CliFiles" />
      <ComponentGroupRef Id="ServiceFiles" />
      <ComponentGroupRef Id="RecoveryFiles" />
      <ComponentGroupRef Id="ServiceRegistration" />
      <ComponentGroupRef Id="Docs" />
    </Feature>
  </Package>
</Wix>
