<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX Burn bundle for FileKeep: stock WixStandardBootstrapperApplication
     (hyperlinkLicense theme) with FileKeep branding. No custom theme — the
     generic installer the user asked for. Shows the FileKeep logo, product
     name and version, a progress bar, and a "Launch FileKeep" button
     on the Success page. Wraps the MSI built from UsenetBackup.wxs.

     Build on Windows after the MSI:
       wix build -arch x64 -ext <Bal wixext dll> -d SrcRoot=C:\fk -d MsiPath=C:\ub\filekeep-0.08.12.msi -o C:\ub\FileKeep-Setup.exe install/Bundle.wxs
     (see install/run-vm-build.ps1 for the full build script).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle Name="FileKeep"
          Version="0.08.12"
          Manufacturer="J. Treichel"
          UpgradeCode="A3B8F2C1-7D4E-4A9B-8C5D-2E6F1A3B4C5D"
          IconSourceFile="$(var.SrcRoot)/assets/filekeep.ico">

    <!-- WixStandardBootstrapperApplication must sit directly under the inline
         <BootstrapperApplication> (the extension only parses it there; a Ref
         rejects the child). Theme="hyperlinkLicense" is the stock payload
         group; LogoFile brands its Install page with the FileKeep logo.
         The stock theme's logo slot is a 64x64 ImageControl, so LogoFile
         must be a square image — assets/filekeep-logo.png (64x64, from the
         vault-door icon). The wide filekeep-banner.bmp is for the MSI's
         WixUI dialogs only (493x58 banner slot) and renders broken here.
         LogoFile is embedded automatically by the Bal extension as the
         "logo.png" UX payload (via the WixStdbaLogo binder variable); no
         explicit Payload element is needed or allowed (it would duplicate).
         LicenseUrl is empty, so no license link is shown.
         The MSI's own exit-dialog checkbox never shows inside a bundle, so
         launch-on-finish lives here via LaunchTarget: the Success page shows
         a "Launch FileKeep" button when it is set. -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="hyperlinkLicense"
        LicenseUrl=""
        LogoFile="$(var.SrcRoot)/assets/filekeep-logo.png"
        LaunchTarget="[ProgramFiles6432Folder]FileKeep\gui\FileKeepGui.exe"
        LaunchWorkingFolder="[ProgramFiles6432Folder]FileKeep\gui"
        SuppressOptionsUI="yes"
        ShowVersion="yes" />
    </BootstrapperApplication>

    <!-- Detect an installed WebView2 runtime (any version) for the ExePackage below. -->
    <util:RegistrySearch Id="WebView2RuntimeSearch"
                         Root="HKLM"
                         Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                         Value="pv"
                         Variable="WebView2RuntimeVersion" />

    <Chain>
      <!-- WebView2 runtime: the dashboard GUI cannot start without it.
           Evergreen bootstrapper, downloaded from Microsoft at install time
           (not embedded, keeps the bundle small). Skipped when the runtime
           is already present (registry detect). Vital=yes: if the WebView2
           install fails, the whole install stops with an error instead of
           silently continuing — re-running the installer retries it.
           Permanent=yes: it's a shared system component, not ours to remove. -->
      <ExePackage Id="WebView2Runtime"
                  Cache="no" Compressed="no" PerMachine="yes" Permanent="yes" Vital="yes"
                  SourceFile="MicrosoftEdgeWebview2Setup.exe"
                  DownloadUrl="https://go.microsoft.com/fwlink/p/?LinkId=2124703"
                  DetectCondition="WebView2RuntimeVersion"
                  InstallCommand="/silent /install" />
      <!-- No DisplayInternalUI attribute: the default already routes everything
           to the bootstrapper (bal:DisplayInternalUICondition unset = false). -->
      <MsiPackage SourceFile="$(var.MsiPath)"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
