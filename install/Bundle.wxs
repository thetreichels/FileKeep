<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX Burn bundle for FileKeep: stock WixStandardBootstrapperApplication
     (hyperlinkLicense theme) with FileKeep branding. No custom theme — the
     generic installer the user asked for. Shows the FileKeep logo, product
     name and version, and a progress bar. No Launch button on the Success
     page (removed 2026-10-25: the app opens from its shortcut instead).
     Wraps the MSI built from FileKeep.wxs.

     Build on Windows after the MSI:
       wix build -arch x64 -ext <Bal wixext dll> -d SrcRoot=C:\fk -d ProductVersion=<from repo-root VERSION> -d MsiPath=C:\ub\filekeep-<version>.msi -o C:\ub\FileKeep-Setup.exe install/Bundle.wxs
     (see install/run-vm-build.ps1 for the full build script).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="FileKeep"
          Version="$(var.ProductVersion)"
          Manufacturer="J. Treichel"
          UpgradeCode="A3B8F2C1-7D4E-4A9B-8C5D-2E6F1A3B4C5D"
          IconSourceFile="$(var.SrcRoot)/assets/filekeep.ico">

    <!-- WixStandardBootstrapperApplication must sit directly under the inline
         <BootstrapperApplication> (the extension only parses it there; a Ref
         rejects the child). Theme="hyperlinkLicense" is the stock payload
         group; LogoFile brands its Install page with the FileKeep logo.
         The stock theme's logo slot is a 64x64 ImageControl, so LogoFile
         must be a square image — assets/filekeep-logo.png (64x64, the
         current app icon, downscaled from the 1024 master). The wide filekeep-banner.bmp is for the MSI's
         WixUI dialogs only (493x58 banner slot) and renders broken here.
         LogoFile is embedded automatically by the Bal extension as the
         "logo.png" UX payload (via the WixStdbaLogo binder variable); no
         explicit Payload element is needed or allowed (it would duplicate).
         LicenseUrl is empty, so no license link is shown.
         The MSI's own exit-dialog checkbox never shows inside a bundle, and
         no LaunchTarget is set, so the Success page shows only Close. -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="hyperlinkLicense"
        LicenseUrl=""
        LogoFile="$(var.SrcRoot)/assets/filekeep-logo.png"
        SuppressOptionsUI="yes"
        ShowVersion="yes" />
    </BootstrapperApplication>

    <Chain>
      <!-- No DisplayInternalUI attribute: the default already routes everything
           to the bootstrapper (bal:DisplayInternalUICondition unset = false). -->
      <MsiPackage SourceFile="$(var.MsiPath)"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
