<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UsenetBackup.Cli</RootNamespace>
    <AssemblyName>FileKeep</AssemblyName>
      <!-- Single-file self-contained publish: the MSI installs the exe + native deps explicitly. -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bundle SQLitePCLRaw native library (e_sqlite3.dll) into the single file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
</PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsenetBackup.Core\UsenetBackup.Core.csproj" />
  </ItemGroup>

</Project>
