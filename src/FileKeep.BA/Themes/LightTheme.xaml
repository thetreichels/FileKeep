<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11 light theme brushes for the FileKeep installer -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#616161"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#107C10"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>
</ResourceDictionary>
