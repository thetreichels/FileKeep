<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11 dark theme brushes for the FileKeep installer -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A7A7A7"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#353535"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F1707B"/>
</ResourceDictionary>
