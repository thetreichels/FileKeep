<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UsenetBackup.Recovery</RootNamespace>
    <AssemblyName>FileKeepRecovery</AssemblyName>
    <ApplicationIcon>../../assets/filekeep.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <!-- WinRE has no .NET runtime; publish self-contained for USB use. -->
      <!-- Single-file self-contained publish: the MSI installs the exe + native deps explicitly. -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bundle SQLitePCLRaw native library (e_sqlite3.dll) into the single file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
</PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UsenetBackup.Core\UsenetBackup.Core.csproj" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
