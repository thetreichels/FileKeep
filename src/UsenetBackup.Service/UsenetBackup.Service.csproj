<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UsenetBackup.Service</RootNamespace>
    <AssemblyName>usenet-backup-service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UsenetBackup.Core\UsenetBackup.Core.csproj" />
  </ItemGroup>

  <!-- Ship the example config next to the binary. -->
  <ItemGroup>
    <None Include="service.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
