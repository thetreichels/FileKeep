<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UsenetBackup.Service</RootNamespace>
    <AssemblyName>FileKeepService</AssemblyName>
    <ApplicationIcon>../../assets/filekeep.ico</ApplicationIcon>
      <!-- Single-file self-contained publish: the MSI installs the exe + native deps explicitly. -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bundle SQLitePCLRaw native library (e_sqlite3.dll) into the single file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Installer size: trim unused framework code (partial = only trimmable
         assemblies) and drop ICU globalization data (app is English-only). -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
</PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UsenetBackup.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UsenetBackup.Core\UsenetBackup.Core.csproj" />
  </ItemGroup>

  <!-- Ship the example config next to the binary. -->
  <ItemGroup>
    <None Include="service.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Dashboard single-page app, served from memory with the CSRF token injected. -->
  <ItemGroup>
    <EmbeddedResource Include="Dashboard\Web\index.html" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Yubico.YubiKey" Version="1.18.0" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>

  <!-- Trimming: the Yubico SDK uses reflection internally for HID device
       discovery; preserve the whole assembly rather than risk breakage. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Yubico.YubiKey" />
  </ItemGroup>

</Project>
