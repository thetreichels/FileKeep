<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UsenetBackup.Service</RootNamespace>
    <AssemblyName>UsenetBackupService</AssemblyName>
      <!-- Single-file self-contained publish: the MSI installs the exe + native deps explicitly. -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bundle SQLitePCLRaw native library (e_sqlite3.dll) into the single file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
</PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UsenetBackup.Core\UsenetBackup.Core.csproj" />
  </ItemGroup>

  <!-- Ship the example config next to the binary. -->
  <ItemGroup>
    <None Include="service.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
