{
  "dashboardBind": "127.0.0.1",
  "dashboardPort": 15789,
  "jobs": [
    {
      "mode": "incremental",
      "name": "documents",
      "repo": "C:\\Backup\\repo",
      "schedule": "daily 02:00",
